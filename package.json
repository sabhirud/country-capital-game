{
  "name": "capital-conquest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Capital Conquest \u2014 learn all 197 world capitals with spaced repetition, flags, a 3D globe and a map to conquer.",
  "scripts": {
    "geo": "node scripts/build-geo.mjs",
    "predev": "npm run geo",
    "dev": "vite",
    "prebuild": "npm run geo",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "pretest": "npm run geo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node e2e/smoke.cjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "d3-geo": "^3.1.2",
    "d3-interpolate": "^3.0.2",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-selection": "^3.0.13",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "flag-icons": "^7.6.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
